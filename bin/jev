#!/bin/sh
# Runs jevkit from this checkout with whatever python3 is on PATH. No install step, no dependencies.
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
# On Windows (git-bash/MSYS), pwd returns /c/... which native Windows Python doesn't understand.
# Try pwd -W (Windows style) or cygpath conversion.
if case "$here" in /c/*|/d/*|/e/*) true;; *) false;; esac; then
  if hereW="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd -W 2>/dev/null)"; then
    here="$hereW"
  elif command -v cygpath >/dev/null 2>&1; then
    here="$(cygpath -w "$here")"
  fi
fi
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m jevkit "$@"
